# AINetUI Environment Configuration

# ============================================================================
# PACKET CAPTURE SETTINGS
# ============================================================================
# Network interface from tshark -D (Wi-Fi is #5 on your system)
CAPTURE_INTERFACE=5

# Mock mode: true = generate fake packets, false = real capture
# USING MOCK MODE - generates realistic DNS attack traffic
MOCK_MODE=false

# PCAP replay mode - using relative path to project root
PCAP_FILE=../ultimate.pcapng

# Loop PCAP file indefinitely (true/false)
PCAP_LOOP=true

# PCAP playback speed (1.0 = realtime, 2.0 = 2x speed, 0 = as fast as possible)
PCAP_SPEED=1.0

# ============================================================================
# CONDENSER SETTINGS
# ============================================================================
# Time window for flow aggregation (seconds)
WINDOW_SIZE=2

# Anomaly detection threshold (standard deviations)
ANOMALY_THRESHOLD=2.5

# Minimum flows to trigger analysis
MIN_FLOWS_FOR_ALERT=5

# ============================================================================
# AI/LLM SETTINGS
# ============================================================================
# AI Mode: "local" or "remote"
AI_MODE=remote

# === LOCAL OLLAMA SETTINGS ===
OLLAMA_URL=http://localhost:11434
LOCAL_AI_MODEL=mistral:7b

# === REMOTE SERVER SETTINGS ===
REMOTE_AI_URL=https://chatucy.cs.ucy.ac.cy/api/send_message
REMOTE_AI_MODEL=llama3.1:latest
REMOTE_WEBSEARCH=false
REMOTE_CLIENT_RAG=false

# === COMMON AI SETTINGS ===
AI_TIMEOUT=30
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=250

# ============================================================================
# SERVER SETTINGS
# ============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# ============================================================================
# CORS SETTINGS
# ============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================
ENABLE_WEBSOCKET=true
WS_PING_INTERVAL=20
MAX_EVENTS_IN_MEMORY=1000
LOG_FILE=ainetui.log
